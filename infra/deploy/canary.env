# ── Canary Environment (Phase 6) ───────────────────────────────────────────────
# $50 initial capital. Hard-coded $500 max (manual review above).
# This file is read by scripts/run_canary.sh and the container entrypoint.

# ── Trading Mode ───────────────────────────────────────────────────────────────
BOT_MODE=live
BOT_ENABLE_LIVE_TRADING=1
BOT_FORCE_MOCK=0

# ── Capital Limits (hard-coded cap) ────────────────────────────────────────────
BOT_MAX_BANKROLL_USDC=50
BOT_MAX_POSITION_SIZE=10          # per-trade cap, USDC
BOT_MAX_DAILY_LOSS_USDC=10         # daily loss kill threshold
BOT_MAX_DAILY_BUY_VOLUME_USDC=500  # UTC-midnight reset

# ── Market Filter ──────────────────────────────────────────────────────────────
BOT_MARKET_FILTER=btc_5m,btc_15m

# ── Signal Parameters ──────────────────────────────────────────────────────────
BOT_KELLY_FRACTION=0.25           # quarter-Kelly
BOT_KELLY_MAX_PCT=0.03            # 3% of bankroll per trade max
BOT_MIN_EDGE=0.005                # 0.5% minimum edge after fees
BOT_MAX_TTL_MS=5000               # 5s max order TTL

# ── Defense Thresholds ─────────────────────────────────────────────────────────
BOT_OFI_ALERT_THRESHOLD=3.0       # EXTREME → freeze
BOT_OFI_CAUTION_THRESHOLD=1.5     # CAUTION → halve size

# ── Circuit Breaker ─────────────────────────────────────────────────────────────
BOT_CB_FAILURE_THRESHOLD=3        # consecutive failures to OPEN
BOT_CB_OPEN_DURATION_MS=5000      # 5s OPEN cooldown

# ── Rate Limits (Polymarket CLOB V2) ───────────────────────────────────────────
BOT_RATE_LIMIT_ORDERS_PER_SEC=10
BOT_RATE_LIMIT_CANCELS_PER_SEC=30
BOT_RATE_LIMIT_QUERIES_PER_SEC=20

# ── Logging & Journal ───────────────────────────────────────────────────────────
BOT_LOG_LEVEL=debug
BOT_JOURNAL_PATH=/var/log/crowdintel/
BOT_JOURNAL_FLUSH_MS=1000         # flush journal every 1s

# ── Kill Switch ─────────────────────────────────────────────────────────────────
BOT_KILL_SWITCH_FILE=/tmp/crowdintel_kill
BOT_KILL_SWITCH_SIGNAL=SIGUSR1

# ── Observability ───────────────────────────────────────────────────────────────
BOT_METRICS_PORT=9090
BOT_METRICS_ENDPOINT=/metrics

# ── Deployment ─────────────────────────────────────────────────────────────────
BOT_DEPLOY_ENV=canary
BOT_DEPLOY_PHASE=6
