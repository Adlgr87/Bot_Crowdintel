# NON-SECRET systemd EnvironmentFile template for /etc/crowdintel/config.
# Secrets belong in /etc/crowdintel/credentials/* via LoadCredential.
# Do not copy this file unchanged into production.
#
# The process rejects every BOT_/CLOB_/GAMMA_/WS_ variable that this build does
# not read, so a typo or a leftover from an older deployment fails startup
# instead of being ignored. BOT_MODE is mandatory and has no default:
#
#   replay - fully offline; venue parameters may come from ENV fixtures; no
#            credentials and no journal. `BOT_MODE=replay` plus a 64-hex
#            BOT_PRIVATE_KEY_HEX (any 32-byte value; nothing is transmitted)
#            and a market slug is a complete configuration.
#   paper  - live public market data and live metadata resolution, fills are
#            simulated locally and never sent; needs BOT_ALPHA_BEARER_TOKEN and
#            a signing key, but no venue credentials, no journal and no arming.
#   live   - real orders: venue credentials, the journal and
#            BOT_ENABLE_LIVE_TRADING=1 are all required.
#
# Validate the file with `crowdintel-metadata` (reads no secret; requires
# BOT_MODE=paper|live) and prove the account with `crowdintel-preflight`
# (requires BOT_MODE=live; refuses to run with a signing key present).

BOT_MODE=live
BOT_ENABLE_LIVE_TRADING=0
# Select the market by slug or by condition id (one of the two is required).
BOT_MARKET_SLUG=replace-me
# BOT_CONDITION_ID=0x...
# Required for multi-outcome markets; single-token markets may omit it.
BOT_OUTCOME=Yes
BOT_SIGNATURE_TYPE=0
BOT_ORDER_TYPE=FAK

# Tick size, minimum order size, taker fee curve, negative-risk flag and the
# outcome token id are venue metadata: paper/live reject them here and resolve
# them at startup from GAMMA_HOST/CLOB_HOST. They exist only for replay runs.
# Run `crowdintel-metadata` to inspect the resolved values before arming.

BOT_BANKROLL_USD=1000
BOT_KELLY_FRACTION=0.10
BOT_MIN_EDGE=0.02
BOT_MIN_CONFIDENCE=0.85
BOT_MAX_Q_VALUE=0.05
BOT_MAX_ORDER_USD=100
BOT_MAX_EXPOSURE_USD=250
BOT_MAX_DAILY_LOSS_USD=50
BOT_INITIAL_POSITION_SHARES=0

# Order journal (live only: it records venue evidence, so replay and paper
# reject these three variables). systemd StateDirectory gives
# /var/lib/crowdintel a writable, persistent home under ProtectSystem=strict.
BOT_LEDGER_PATH=/var/lib/crowdintel/orders.journal
BOT_LEDGER_FSYNC=1
BOT_LEDGER_MAX_BYTES=67108864
# Reject the market when the venue clock differs by more than this.
BOT_MAX_CLOCK_OFFSET_MS=2000
BOT_PRESIGN_TTL_MS=3000
BOT_SIGNAL_TTL_MS=2000
BOT_MAX_BOOK_AGE_MS=3000

BOT_ALPHA_BIND=127.0.0.1
BOT_ALPHA_PORT=8088
BOT_PIN_CPU=2
BOT_COLD_CPU=3
BOT_KILL_SWITCH_FILE=/run/crowdintel/kill

CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market
# User-data channel: leave empty to derive /ws/user from WS_HOST.
# BOT_USER_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/user
# Optional libcurl public-key pin, e.g. sha256//base64...; rotate operationally.
BOT_TLS_PIN=

# Type 1/2 only: maker proxy/safe and address owning the L2 API credentials.
# BOT_MAKER_ADDRESS=0x...
# BOT_API_ADDRESS=0x...

# GTD only. Must be >=120; wire expiry adds the venue's 60-second buffer.
# BOT_GTD_TTL_SECONDS=120
