# NON-SECRET systemd EnvironmentFile template.
# Secret values belong in /etc/crowdintel/credentials/* via LoadCredential.
# Do not copy this file unchanged into production.

BOT_ENABLE_LIVE_TRADING=0
BOT_MARKET_SLUG=replace-me
BOT_TOKEN_ID=replace-with-uint256-decimal
BOT_NEG_RISK=0
BOT_SIGNATURE_TYPE=0
BOT_ORDER_TYPE=FAK
# Expectation only: live mode takes the tick from the venue and preflight fails
# on disagreement.
BOT_TICK_SIZE=0.01

# Must be fetched/verified from current market metadata. The default 0.07 is
# conservative but not a substitute for venue reconciliation.
BOT_TAKER_FEE_RATE=0.07
BOT_BANKROLL_USD=1000
BOT_KELLY_FRACTION=0.10
BOT_MIN_EDGE=0.02
BOT_MIN_CONFIDENCE=0.85
BOT_MAX_Q_VALUE=0.05
BOT_MAX_ORDER_USD=100
BOT_MAX_EXPOSURE_USD=250
BOT_MAX_DAILY_LOSS_USD=50
BOT_MIN_SIZE_SHARES=5
# Must stay 0 in live mode: inventory comes from reconciliation, not config.
BOT_INITIAL_POSITION_SHARES=0
BOT_PRESIGN_TTL_MS=3000
BOT_SIGNAL_TTL_MS=2000
BOT_MAX_BOOK_AGE_MS=3000

BOT_ALPHA_BIND=127.0.0.1
BOT_ALPHA_PORT=8088
BOT_PIN_CPU=2
BOT_COLD_CPU=3
BOT_KILL_SWITCH_FILE=/run/crowdintel/kill

CLOB_HOST=https://clob.polymarket.com
WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Optional libcurl public-key pin, e.g. sha256//base64...; rotate operationally.
BOT_TLS_PIN=

# Type 1/2 only: maker proxy/safe and address owning the L2 API credentials.
# BOT_MAKER_ADDRESS=0x...
# BOT_API_ADDRESS=0x...

# GTD only. Must be >=120; wire expiry adds the venue's 60-second buffer.
# BOT_GTD_TTL_SECONDS=120

# ── Operating mode ───────────────────────────────────────────────────────────
# replay (l2_backtester binary), paper (real market data, no egress, no
# simulated fills) or live. "mock" is still accepted as an alias for paper.
BOT_MODE=paper

# ── Venue metadata (Phase 1) ─────────────────────────────────────────────────
# In live mode tick size, minimum order size, negative-risk flag, fee schedule
# and market status are read from the venue. The values in this file are only
# expectations that preflight cross-checks; a disagreement blocks startup.
GAMMA_HOST=https://gamma-api.polymarket.com
BOT_CONDITION_ID=
# The supervisor blocks egress while venue metadata is older than the age
# budget, so the budget must be at least twice the refresh period.
BOT_METADATA_MAX_AGE_MS=90000
BOT_METADATA_REFRESH_MS=30000
BOT_MAX_TAKER_FEE_RATE=0.07
# Protocol-v2 position ids settle through the Combos exchange (v3). Leave at 0:
# that path is not covered by this signer's test matrix.
BOT_ALLOW_PROTOCOL_V2=0

# Chain verification. Required in live: no contract constant is trusted until
# eth_chainId answers 137.
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_BACKUP_URL=

# ── Persistent ledger (Phase 2) ──────────────────────────────────────────────
# Append-only journal + checkpoint. One directory per instance, never shared.
BOT_LEDGER_DIR=/var/lib/crowdintel
BOT_LEDGER_FSYNC=1
BOT_LEDGER_CHECKPOINT_EVERY=512

# ── User channel (Phase 3) ───────────────────────────────────────────────────
BOT_USER_WS_ENABLED=1
BOT_USER_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/user
BOT_USER_WS_KEEPALIVE_MS=8000
BOT_USER_WS_IDLE_MS=20000
BOT_USER_WS_PONG_MS=30000
BOT_USER_WS_RECONNECT_MIN_MS=250
BOT_USER_WS_RECONNECT_MAX_MS=5000

# ── Order heartbeat (Phase 4) ────────────────────────────────────────────────
# Opt-in cancel-on-disconnect. Once started, the venue cancels EVERY open order
# owned by these credentials ~10 s (worst case ~15 s) after the last valid beat.
# Use dedicated credentials for the process that owns the heartbeat.
BOT_HEARTBEAT_ENABLED=0
BOT_HEARTBEAT_INTERVAL_MS=5000
BOT_HEARTBEAT_WARN_MS=7000
BOT_HEARTBEAT_BLOCK_MS=9000
BOT_HEARTBEAT_ASSUME_CANCELLED_MS=10000
BOT_HEARTBEAT_MAX_FAILURES=2

# ── Reconciliation and readiness (Phase 5) ───────────────────────────────────
BOT_RECON_MAX_PAGES=4
# Startup reconciliation is unconditional in live mode; there is no switch.

# ── Preflight (Phase 6) ──────────────────────────────────────────────────────
BOT_PREFLIGHT_TOKEN_FILE=/run/crowdintel/preflight.pass
BOT_PREFLIGHT_MAX_AGE_S=900
BOT_MAX_CLOCK_SKEW_S=10
BOT_MIN_COLLATERAL=1
# 0 = derive from BOT_MAX_EXPOSURE_USD + 10% margin. Never max_uint256.
BOT_TARGET_ALLOWANCE=0
# Opt-in probes: each one touches the venue with these credentials, and each
# reports SKIP (never PASS) while disabled, so READY always shows what was not
# proven. For canary preparation set the first two to 1 (see CANARY_CHECKLIST H2).
# L1: proves the private key owns the configured API credentials.
BOT_PREFLIGHT_CHECK_L1=0
# User WSS: proves the channel every fill arrives on can subscribe.
BOT_PREFLIGHT_CHECK_USER_WS=0
# Heartbeat: proves which path/body the venue accepts. A successful probe leaves
# the cancel-on-disconnect contract ACTIVE for these credentials, so run it only
# with the bot stopped; it skips itself when open orders exist.
BOT_PREFLIGHT_CHECK_HEARTBEAT=0

# ── Configuration hygiene (Phase 7) ──────────────────────────────────────────
# Reject any BOT_*/CLOB_*/POLY_*/WS_*/POLYGON_*/GAMMA_*/CROWDINTEL_* variable
# this binary does not read, so an ignored setting is a hard error.
BOT_STRICT_ENV=1

# Bounded session length in ms (0 = run until signalled).  Useful for smoke
# tests and canary rehearsals: the run terminates even with no alpha signals.
BOT_SESSION_TIMEOUT_MS=0
