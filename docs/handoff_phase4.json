    },
    "test_ladder": {
      "file": "tests/unit/test_ladder.cpp",
      "test_count": 4,
      "checks": 18,
      "status": "all_pass"
    }
  },
  "build_system": {
    "cmakelists": "core/CMakeLists.txt",
    "new_targets": ["test_fees", "test_kelly", "test_ladder"],
    "ctest_entries": ["fee_units", "kelly_units", "ladder_units"]
  },
  "archived_files": [
    "core/src/archive/kelly_sizer.hpp.archived",
    "core/src/archive/ladder_skew.hpp.archived"
  ]
}
